# Google Apps Script Web App URL for attendance data
GOOGLE_ATTENDANCE_API_URL=https://script.google.com/macros/s/AKfycbwsLdJ1ZYYGTt8gUngGB2c4CstCReB09qP0cXvTxJnDUcAHlYW82ohQ3HCtoISiLZqg/exec

# 64-char secret used to sign session cookies
SESSION_SECRET=

# Comma-separated list of allowed sections (default: 3A,3B,5A,5B,7A,7B)
ALLOWED_SECTIONS=3A,3B,5A,5B,7A,7B

# Cache duration in milliseconds (default: 60000 = 1 minute)
ATTENDANCE_CACHE_TTL_MS=60000

# (Optional) Supabase configuration for persistent avatar image storage.
# If omitted or left empty, the application uses local in-memory fallback storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Optional) MongoDB connection for optional event logging or external persistence.
# If omitted or left empty, the app runs without external database dependency.
MONGO_URL=
DB_NAME=smart_attendance
